{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately NOT the name of the live geraltheart.com worker, so a deploy can never overwrite it.
  "name": "geraltheart-v2",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "pnpm build:site",
    "watch_dir": ["src", "content"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Everything else is served straight from the asset store without running the Worker.
    "run_worker_first": ["/mcp", "/mcp/"],
  },
  // Workers Rate Limiting binding: 60 MCP requests per minute per client IP (per Cloudflare location).
  "ratelimits": [{ "name": "MCP_RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "vars": {
    // Extra hosts allowed to reach /mcp, comma separated (defaults live in src/worker/index.ts).
    "ALLOWED_HOSTS": "",
  },
  "observability": { "enabled": true },
}
