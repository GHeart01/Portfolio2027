---
import Pane from "../Pane.astro";
import { experience, formatRange } from "../../content/index";
---

<div class="stack">
  {experience.map((e) => (
    <Pane title={e.company} id={e.id}>
      <header class="role">
        <h3>{e.role}</h3>
        <p class="dim">
          {formatRange(e)}, {e.location}
        </p>
      </header>
      {e.summary && <p class="role-summary">{e.summary}</p>}
      <ul class="bullets">
        {e.highlights.map((h) => (
          <li id={`${e.id}-${h.id}`}>{h.text}</li>
        ))}
      </ul>
      {e.stack?.length ? (
        <ul class="tags" aria-label="Stack">
          {e.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      ) : null}
    </Pane>
  ))}
</div>
