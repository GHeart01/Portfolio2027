---
import Pane from "../Pane.astro";
import { experience, formatRange } from "../../content/index";
---

<div class="stack">
  {experience.map((e) => (
    <Pane title={e.company} id={e.id}>
      <header class="role">
        <h3>{e.role}</h3>
        <p class="dim">
          {formatRange(e)}, {e.location}
        </p>
      </header>
      {e.summary && <p class="summary">{e.summary}</p>}
      <ul class="bullets">
        {e.highlights.map((h) => (
          <li id={`${e.id}-${h.id}`}>{h.text}</li>
        ))}
      </ul>
      {e.stack?.length ? (
        <ul class="tags" aria-label="Stack">
          {e.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      ) : null}
    </Pane>
  ))}
</div>

<style>
  .role {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 3ch;
    margin-bottom: 0.6rem;
  }
  .summary {
    margin-bottom: 0.6rem;
    color: var(--dim);
  }
  .bullets {
    display: grid;
    gap: 0.45rem;
    max-width: 80ch;
  }
  .tags {
    margin-top: 0.75rem;
  }
</style>
